{
  "name": "jade-harbor",
  "version": "2.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0 --port 4173",
    "build": "node scripts/build-release.mjs",
    "preview": "vite preview --host 0.0.0.0 --port 4173",
    "test": "vitest run",
    "test:browser": "node tests/browser.mjs",
    "test:production": "node tests/production.mjs",
    "test:city": "node tests/city-browser.mjs",
    "test:visual": "node tests/city-visual.mjs",
    "test:flight": "node tests/flight.mjs",
    "test:archive": "node tests/archive-smoke.mjs",
    "test:progression": "node tests/progression-browser.mjs",
    "test:automation": "node tests/automation-browser.mjs",
    "test:branding": "node scripts/verify-branding.mjs",
    "test:copy": "node scripts/check-release-copy.mjs",
    "test:inventory": "node tests/inventory-regression.test.cjs",
    "test:combat": "node tests/combat-regression.test.cjs",
    "test:save": "node tests/save-regression.test.cjs",
    "test:physics": "node tests/physics-chunk-regression.test.cjs",
    "test:interaction": "node tests/pointerlock-regression.test.cjs",
    "test:viewmodel": "node tests/viewmodel-shape-regression.test.cjs && node tests/viewmodel-orientation-regression.test.cjs",
    "test:performance": "node tests/meshing-performance-regression.test.cjs && node tests/mesh-queue-regression.test.cjs",
    "test:gameplay": "node tests/gameplay-mode-regression.test.cjs",
    "test:catalog": "node tests/catalog-gameplay-regression.test.cjs",
    "test:integration": "node tests/gameplay-paths-regression.test.cjs && node tests/cross-system-regression.test.cjs && node tests/mode-transition-regression.test.cjs && node tests/world-systems-regression.test.cjs",
    "test:deep": "node tests/deep-functional-regression.test.cjs && node tests/residual-stability-regression.test.cjs && node tests/deep-integrity-regression.test.cjs",
    "test:regression": "npm run test:inventory && npm run test:combat && npm run test:save && npm run test:physics && npm run test:reliability && npm run test:interaction && npm run test:viewmodel && npm run test:gameplay && npm run test:catalog && npm run test:integration && npm run test:performance && npm run test:deep",
    "test:release": "npm run build && npm run test:release:checks",
    "test:release:checks": "node scripts/check-release-copy.mjs && node scripts/check-documentation.mjs && node tests/release-ui-copy-regression.test.mjs && node scripts/check-syntax.mjs && node tests/frontend-hygiene.test.mjs && node tests/controls-held-model.test.mjs && node tests/ui-combat-regression.mjs && npm run test:branding && npm run test:regression",
    "test:release-integrity": "node --test tests/release-integrity.test.mjs",
    "test:archive-structure": "node tests/archive-structure.mjs",
    "verify:dist": "node scripts/verify-dist.mjs",
    "test:reliability": "node tests/engine-reliability-regression.test.cjs",
    "profile:reliability": "node scripts/profile-reliability.cjs",
    "test:world": "vitest run tests/macro-world.test.ts tests/generator-compatibility.test.ts",
    "test:world:browser": "node tests/world-plan-browser.mjs",
    "profile:world": "node scripts/profile-world.cjs",
    "test:metropolis": "vitest run tests/metropolis.test.ts",
    "test:metropolis:browser": "node tests/metropolis-browser.mjs",
    "profile:metropolis": "node scripts/profile-metropolis.cjs",
    "test:landmarks": "vitest run tests/landmarks.test.ts",
    "test:landmarks:browser": "node tests/landmarks-browser.mjs",
    "profile:landmarks": "node scripts/profile-landmarks.cjs",
    "test:city-life": "vitest run tests/city-life.test.ts",
    "test:city-life:browser": "node tests/city-life-browser.mjs",
    "profile:city-life": "node --expose-gc scripts/profile-city-life.cjs",
    "test:urban-density": "vitest run tests/urban-density.test.ts",
    "test:urban-life:browser": "node tests/urban-life-browser.mjs",
    "test:urban-travel:browser": "node tests/urban-travel-browser.mjs",
    "profile:urban-life": "node --expose-gc scripts/profile-urban-life.cjs",
    "test:urban-fabric": "vitest run tests/urban-fabric.test.ts",
    "profile:urban-fabric": "node --expose-gc scripts/profile-urban-fabric.cjs",
    "test:urban-fabric:browser": "node tests/urban-fabric-browser.mjs",
    "test:travel-journal": "node tests/travel-journal-browser.mjs",
    "test:presentation": "node tests/presentation-browser.mjs",
    "test:docs": "node scripts/check-documentation.mjs",
    "package:release": "node scripts/run-python.mjs scripts/package-release.py",
    "test:regional-world": "vitest run tests/regional-world.test.ts",
    "profile:regional-world": "node --expose-gc scripts/profile-regional-world.cjs",
    "test:generator-v10": "vitest run tests/generator-v10.test.ts",
    "profile:city-activity": "node --expose-gc scripts/profile-city-activity.cjs",
    "test:world-presentation": "vitest run tests/world-presentation.test.ts",
    "test:world-presentation:browser": "node tests/world-presentation-browser.mjs",
    "test:world-exploration:browser": "node tests/world-exploration-browser.mjs",
    "test:graphics-quality": "vitest run tests/graphics-quality.test.ts",
    "test:graphics-quality:browser": "node tests/graphics-quality-browser.mjs",
    "profile:graphics-quality": "node tests/graphics-performance-profile.mjs",
    "profile:distant-rendering": "node --expose-gc scripts/profile-distant-rendering.cjs",
    "generate:geographic-map": "node scripts/world-plan-map.cjs",
    "generate:district-map": "node scripts/metropolis-map.cjs",
    "test:city-presentation": "node tests/presentation-browser.mjs"
  },
  "dependencies": {
    "three": "0.180.0"
  },
  "devDependencies": {
    "@types/three": "0.180.0",
    "typescript": "5.9.3",
    "vite": "7.1.9",
    "vitest": "3.2.4",
    "@playwright/test": "1.56.0",
    "fake-indexeddb": "6.2.4"
  },
  "license": "MIT"
}
